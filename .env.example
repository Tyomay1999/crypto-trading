# Generate with:
# openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-high-entropy-secret

BETTER_AUTH_BASE_URL=http://localhost:8080

BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:3001

# Local development only.
# A public BETTER_AUTH_BASE_URL rejects this mode.

# Authentication email delivery.
# local_capture is restricted to loopback Better Auth URLs.
AUTH_EMAIL_DELIVERY_MODE=local_capture
AUTH_EMAIL_CAPTURE_DIR=/tmp/delta-auth-mailbox

# Required when AUTH_EMAIL_DELIVERY_MODE=smtp.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
